# Telegram: get a token from @BotFather. Leave ALLOWED_USER_ID empty at first; the bot will tell you yours.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Your timezone (IANA name, e.g. Europe/London, America/New_York, Asia/Shanghai) and quiet hours.
TIMEZONE=UTC
QUIET_START=22:00
QUIET_END=08:00

# Which agent to run: a folder name in agents/, or a path to an agent folder anywhere.
AGENT=mock

# Calendar: "none" or "google" (see README, "Connect Google Calendar").
CALENDAR=none
GOOGLE_CLIENT_SECRET_FILE=credentials.json

# How long an agent may take per turn, in seconds.
TURN_TIMEOUT=60

# Only for AGENT=openai_compat: any OpenAI-compatible endpoint.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
