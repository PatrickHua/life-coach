{
  "permissions": {
    "deny": [
      "mcp__Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Google_Calendar__delete_event"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_setup.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "PushNotification|mcp__claude-code-remote__create_trigger|mcp__claude-code-remote__send_later|mcp__Google_Calendar__create_event|mcp__Google_Calendar__update_event",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/gate.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/mark_reply.py\"" }
        ]
      }
    ]
  }
}
